# Copy these into Streamlit Community Cloud: your app > Settings > Secrets.
# (Locally you can save this file as .streamlit/secrets.toml; it is git-ignored.)

# Hugging Face repo that holds config.json + model.safetensors + tokenizer files of checkpoint-8920
ASR_HF_MODEL = "your-hf-username/wav2vec2-group6-ckpt8920"

# Hide the "model folder" box on the public site
ASR_LOCK_MODEL = "1"

# Only needed if the Hugging Face repo is private (a read token from hf.co/settings/tokens)
# HF_TOKEN = "hf_..."
